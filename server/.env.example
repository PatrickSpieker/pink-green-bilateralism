# Spotify API credentials
# Register at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/auth/spotify/callback

# Apple Music API credentials
# Requires Apple Developer Program membership
# Generate a MusicKit private key at https://developer.apple.com/account/resources/authkeys
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key_contents

# Server config
PORT=3001
CLIENT_URL=http://localhost:5173
